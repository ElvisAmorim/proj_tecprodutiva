
---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";

const titulo = "TecProdutiva";

const artigos = (await getCollection("posts"))
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );
---

<BaseLayout title={titulo}>
  <main class="home-content">
    <h1 class="home-title">Artigos recentes</h1>

    <div class="post-grid">
      {artigos.map((artigo) => (
        <PostCard
          title={artigo.data.title}
          date={artigo.data.pubDate.toISOString().slice(0, 10)}
          category={artigo.data.category}
          image={artigo.data.image}
          imageAlt={artigo.data.imageAlt}
          href={`/posts/${artigo.id}/`}
        />
      ))}
    </div>
  </main>
</BaseLayout>
