
---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";

export async function getStaticPaths() {
  const artigos = await getCollection("posts");

  return artigos.map((artigo) => ({
    params: { slug: artigo.id },
    props: { artigo },
  }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);
---

<PostLayout
  title={artigo.data.title}
  description={artigo.data.description}
  category={artigo.data.category}
  pubDate={artigo.data.pubDate}
  image={artigo.data.image}
  imageAlt={artigo.data.imageAlt}
>
  <Content />
</PostLayout>
